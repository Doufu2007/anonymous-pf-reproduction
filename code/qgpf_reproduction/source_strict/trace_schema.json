    "predicted_particles",
    "raw_likelihoods",
    "normalised_weights",
    "chromosome_amplitudes_before",
    "measured_chromosomes",
    "fitness_values",
    "rotation_angles",
    "rotation_signs",
    "retained_or_replaced_flags",
    "post_optimization_particles",
    "post_optimization_weights",
    "estimate",
    "covariance",
    "rng_state_after_step"
  ],
  "per_generation": ["generation", "population_id", "amplitudes", "measured_bits", "fitness", "best_id"],
